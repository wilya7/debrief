{
  "colors": {
    "primary": "#1a2b3c",
    "secondary": "#2b3c4d",
    "accent": "#e74c3c",
    "background": "#ffffff",
    "text_primary": "#111111",
    "text_secondary": "#666666",
    "code_background": "#f5f5f5",
    "border": "#dddddd"
  },
  "typography": {
    "heading_font_family": "Inter, sans-serif",
    "body_font_family": "Georgia, serif",
    "code_font_family": "Fira Code, monospace",
    "heading_size_base": "48px",
    "body_size_base": "16px",
    "heading_weight": "700",
    "body_weight": "400",
    "line_height": "1.6"
  },
  "spacing": {
    "margin_pct": "5%",
    "gap": "16px",
    "section_gap": "48px"
  },
  "layout": {
    "slide_width": "1920px",
    "slide_height": "1080px",
    "column_gap": "24px"
  },
  "data_viz": {
    "primary_colormap": "viridis",
    "axis_color": "#333333",
    "grid_color": "#eeeeee",
    "annotation_color": "#e74c3c"
  },
  "constraints": {
    "permitted_diagram_types": ["mermaid", "inline-svg", "rough.js"],
    "math_renderer": "katex",
    "roughjs_defaults": {
      "roughness": 2.5,
      "bowing": 2,
      "fill_style": "hachure",
      "arrowhead_style": "hand-drawn"
    }
  },
  "provenance": {
    "colors.primary": {"source": "default"},
    "typography.heading_font_family": {"source": "default"}
  }
}
